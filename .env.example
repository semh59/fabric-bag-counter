# Copy to .env and fill in real values. Every variable here is one the
# codebase actually reads (verified by grepping os.environ.get/os.getenv
# across packages/, services/, drivers/) -- nothing speculative.

# --- Database (server stack: api, jobrunner, erp-relay) ---
# In docker-compose.yml these already point at the bundled postgres
# service; only override if connecting to a different database.
DATABASE_URL=postgresql+asyncpg://cuval_admin:cuval_secure_2026@localhost:5434/cuval_sayim_db
DATABASE_SYNC_URL=postgresql://cuval_admin:cuval_secure_2026@localhost:5434/cuval_sayim_db

# --- Auth ---
# REQUIRED for a real deployment: without this, a random key is generated
# at process startup and every login session is invalidated on every
# restart (see services/api/auth.py). Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8080
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- First-run bootstrap ---
# Only used if the user table is genuinely empty at startup AND you want a
# fixed password instead of the random one that gets generated and logged
# once (see services/api/main.py's lifespan). Leave unset for the random
# one-time password -- the honest default.
# ADMIN_DEFAULT_PASSWORD=
# ENGINEER_DEFAULT_PASSWORD=
# OPERATOR_DEFAULT_PASSWORD=

# --- Edge machine (docker-compose.edge.yml: supervisor, ingest, inference) ---
# The edge machine's postgres connection points at the SERVER stack's
# database over the network -- these two compose files run on different
# physical machines, not the same Docker network.
POSTGRES_HOST=
POSTGRES_PASSWORD=cuval_secure_2026
# Which line this edge machine's inference worker processes. A separate
# `inference` service/machine is needed per line.
LINE_ID=1

# --- Per-camera ingest process (usually set by SupervisorManager via
# --camera-id, not this file -- only needed if starting
# `python -m services.ingest.worker` directly without the supervisor) ---
# CAMERA_ID=
